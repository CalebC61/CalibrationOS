# ---- Core (required) ----
APP_ENV=production            # "production" fails closed if JWT_SECRET/OWNER_PASSWORD missing
MONGO_URL=mongodb+srv://USER:PASS@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
DB_NAME=calibrationos
JWT_SECRET=change-me-long-random-string
CORS_ORIGINS=https://app.thecalibrationcrew.us
OWNER_EMAIL=
OWNER_PASSWORD=
ADMIN_EMAIL=
CONTRACTOR_EMAIL=
CONTRACTOR_PASSWORD=

# ---- Email (Resend) ----
RESEND_API_KEY=
SENDER_EMAIL=

# ---- Payments (Stripe) ----
STRIPE_API_KEY=

# ---- Google Maps (geocoding + drive time) ----
GOOGLE_MAPS_API_KEY=

# ---- Xero invoicing (developer.xero.com) ----
XERO_CLIENT_ID=
XERO_CLIENT_SECRET=
XERO_REDIRECT_URI=https://api.thecalibrationcrew.us/api/auth/xero/callback
XERO_POST_CONNECT_REDIRECT=https://app.thecalibrationcrew.us/settings
XERO_SALES_ACCOUNT_CODE=200

# ---- Module 8: Admin Assist (Gemini) ----
ASSIST_MODULE_ENABLED=true
GOOGLE_API_KEY=
ASSIST_MODEL=
ASSIST_PENDING_TTL_SECONDS=
ASSIST_SELF_BASE_URL=https://api.thecalibrationcrew.us

# ---- Module 9: Partner Growth ----
GROWTH_MODULE_ENABLED=true

# ---- Integration tests only ----
# RUN_INTEGRATION=1
# REACT_APP_BACKEND_URL=http://localhost:8001

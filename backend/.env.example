# ---- Core (required to boot) ----
# "production" refuses to start if JWT_SECRET is still the public dev default.
APP_ENV=production
# Any Atlas user with read/write works. URL-encode special characters in the password.
MONGO_URL=mongodb+srv://USER:PASS@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
DB_NAME=calibrationos
JWT_SECRET=change-me-long-random-string
# Comma-separated browser origins. No trailing slashes. Spaces around commas are ignored.
# Include both hosts so the apex and www can call the API.
CORS_ORIGINS=https://thecalibrationcrew.us,https://www.thecalibrationcrew.us
# Blank OWNER_EMAIL uses caleb@thecalibrationcrew.us. OWNER_PASSWORD has no default in production.
OWNER_EMAIL=
OWNER_PASSWORD=
ADMIN_EMAIL=
CONTRACTOR_EMAIL=
CONTRACTOR_PASSWORD=
# Production default is false. Set true only to load the demo shops.
SEED_DEMO_DATA=false

# ---- Email (Resend) — optional; without a key, mail is logged instead of sent ----
RESEND_API_KEY=
SENDER_EMAIL=

# ---- Payments (Stripe) — optional; blank keeps card charging off ----
STRIPE_API_KEY=

# ---- Google Maps (geocoding + drive time) — optional; blank keeps the mock ----
# Server-side calls. Restrict the key by API (Geocoding + Distance Matrix), not by HTTP referrer.
GOOGLE_MAPS_API_KEY=

# ---- Xero invoicing (developer.xero.com) — optional; blank keeps the mock ----
XERO_CLIENT_ID=
XERO_CLIENT_SECRET=
XERO_REDIRECT_URI=https://api.thecalibrationcrew.us/api/auth/xero/callback
XERO_POST_CONNECT_REDIRECT=https://thecalibrationcrew.us/settings
XERO_SALES_ACCOUNT_CODE=200

# ---- Module 8: Admin Assist (Gemini) — optional; inert until GOOGLE_API_KEY is set ----
ASSIST_MODULE_ENABLED=true
GOOGLE_API_KEY=
# Blank uses gemini-2.5-flash.
ASSIST_MODEL=
# Blank uses 300 seconds.
ASSIST_PENDING_TTL_SECONDS=
# Blank calls this process at http://127.0.0.1:$PORT (port 8001 when PORT is unset).
# ASSIST_SELF_BASE_URL=

# ---- Module 9: Partner Growth ----
GROWTH_MODULE_ENABLED=true

# ---- Integration tests only ----
# RUN_INTEGRATION=1
# REACT_APP_BACKEND_URL=http://localhost:8001

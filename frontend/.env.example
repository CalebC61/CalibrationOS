# Baked in at Vercel build time. The website is thecalibrationcrew.us; this value is the API.
REACT_APP_BACKEND_URL=https://api.thecalibrationcrew.us
REACT_APP_ASSIST_MODULE_ENABLED=true
REACT_APP_GROWTH_MODULE_ENABLED=true
# Stripe → Developers → API keys → publishable key. Use pk_test_ until BILLING_ENABLED is on.
# A pk_live_ key is ignored by the card form.
REACT_APP_STRIPE_PUBLISHABLE_KEY=
# Google Cloud → a browser key with the Places API, HTTP referrer restricted to the site.
# This is not the server GOOGLE_MAPS_API_KEY.
REACT_APP_GOOGLE_MAPS_API_KEY=
